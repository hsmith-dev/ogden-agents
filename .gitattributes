# Keep LF line endings on every OS. Git on Windows otherwise checks files out
# with CRLF, which breaks the `#!/usr/bin/env node` shebang of bin/ogden.js
# (pnpm refuses to pack it: ERR_PNPM_BIN_CRLF) and the installed command.
* text=auto eol=lf
*.png binary
*.jpg binary
*.ico binary
*.node binary
*.tgz binary
*.whl binary
# Windows batch files need CRLF: cmd.exe misreads labels and `goto` in an LF file.
# Stored with CRLF and never converted, so GitHub's Raw and Download buttons serve CRLF too.
*.cmd -text
