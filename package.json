{
  "name": "ogden-agents",
  "version": "0.1.0",
  "private": false,
  "description": "Ogden Agents: a local browser UI for running BMAD with coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsmith-dev/ogden-agents.git"
  },
  "homepage": "https://github.com/hsmith-dev/ogden-agents#readme",
  "bugs": {
    "url": "https://github.com/hsmith-dev/ogden-agents/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "bin": {
    "ogden": "bin/ogden.js"
  },
  "files": [
    "bin",
    "dist",
    "vendor"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build && node scripts/assemble-dist.mjs",
    "start": "pnpm run build && node bin/ogden.js",
    "dev:chat": "pnpm run build && node scripts/dev-chat.mjs",
    "test": "pnpm run build && vitest run",
    "e2e": "pnpm run build && playwright test",
    "e2e:installed": "playwright test --config tests/e2e-installed/playwright.config.ts",
    "typecheck": "pnpm -r --filter \"./packages/**\" run typecheck && tsc -p tsconfig.json",
    "pack": "pnpm run build && pnpm pack",
    "smoke": "node scripts/smoke-installed.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.5.1",
    "@hono/node-server": "^2.1.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "env-paths": "^4.0.0",
    "hono": "^4.13.11",
    "open": "^11.0.4",
    "ulid": "^3.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.84.0",
    "@ogden-agents/server": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
