{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ogden Agents",
  "mainBinaryName": "ogden-agents",
  "version": "1.0.0",
  "identifier": "dev.ogden-agents.app",
  "build": {
    "frontendDist": "../placeholder"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ogden-node"
    ],
    "resources": {
      "../stage/app/": "app/",
      "../stage/npm/": "npm/"
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.5",
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 400
        },
        "appPosition": {
          "x": 170,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 430,
          "y": 190
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "Ogden Agents: a local browser UI for running BMAD with coding agents.",
    "longDescription": "Ogden Agents runs on your computer and lets you assemble AI employees into teams for each of your projects. It needs nothing else installed.",
    "publisher": "Ogden Agents",
    "copyright": "MIT License",
    "homepage": "https://github.com/hsmith-dev/ogden-agents",
    "createUpdaterArtifacts": false,
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libsecret-1-0"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
